# Supabase Configuration (Auth, Postgres `users` / `playlists` / `friends`, Realtime Broadcast)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend & LiveKit Cloud Walkie-Talkie Mesh
EXPO_PUBLIC_API_BASE_URL=https://api.pacelock.run
EXPO_PUBLIC_LIVEKIT_URL=wss://pacelock-sf-west.livekit.cloud

# Spotify Web API OAuth PKCE Client (required for Spotify linking + search)
# Register this exact redirect URI in the Spotify Developer Dashboard:
#   pacelock://spotify-auth-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Apple Music: MusicKit developer token. Required for Apple Music
# catalog search on every platform (the app uses only the dedicated
# Apple Music API, api.music.apple.com) and for full-length playback in
# the web build through MusicKit JS. Mint it with:
#   npm run mint:apple-token -- --key AuthKey_XXXXXXXXXX.p8 --team YOUR_TEAM_ID --origin http://localhost:8081
# The --origin claim is required for web playback: MusicKit JS locks
# queueing to the origins listed in the token (API calls work without
# it, playback silently does not). List every origin you serve from.
# On iOS/Android the catalog previews play in-app.
EXPO_PUBLIC_APPLE_MUSICKIT_DEVELOPER_TOKEN=your-es256-musickit-jwt-developer-token
