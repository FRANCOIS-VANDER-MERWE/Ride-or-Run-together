# Supabase Configuration (Auth, Postgres `users` / `playlists` / `friends`, Realtime Broadcast)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI Backend & LiveKit Cloud Walkie-Talkie Mesh
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_LIVEKIT_URL=
# Walkie-talkie token endpoint. Voice stays simulated while this is empty.
# With `npm run voice:token`, use your computer's LAN IP so phones can reach it,
# for example 
EXPO_PUBLIC_LIVEKIT_TOKEN_URL=

# Read by the token server only. Never prefix these with EXPO_PUBLIC_, because
# those values get bundled into the app.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Spotify Web API OAuth PKCE Client
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
