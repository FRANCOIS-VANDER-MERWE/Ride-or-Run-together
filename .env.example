# Supabase Configuration: Auth plus the Postgres schema in schema.sql
# (profiles, ride_sessions, session_participants, routes, location_pings,
# playlists, session_queue, and friends). Setup: run schema.sql, then
# supabase/rls_policies.sql, in the project SQL editor. See README.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend & LiveKit Cloud Walkie-Talkie Mesh
EXPO_PUBLIC_API_BASE_URL=https://api.pacelock.run
EXPO_PUBLIC_LIVEKIT_URL=wss://pacelock-sf-west.livekit.cloud

# Spotify Web API OAuth PKCE Client
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=pacelock://spotify-auth-callback
