# Backend (required for accounts, sessions, friends, and the shared queue)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Apple Music developer token (required for catalog search and web playback)
# Mint one from your .p8 key: npm run mint:apple-token -- --key /path/to/AuthKey.p8 --team YOUR_TEAM_ID --origin http://localhost:8081
EXPO_PUBLIC_APPLE_MUSICKIT_DEVELOPER_TOKEN=
